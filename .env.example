# Microsoft Foundry
FOUNDRY_PROJECT_ENDPOINT=
FOUNDRY_AGENT_NAME=

# Acceso al panel de demostración. La contraseña debe ser única y la clave
# de sesión debe tener al menos 32 caracteres aleatorios.
ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# En Azure App Service, PORT lo configura la plataforma.
# En local, el servidor usa 3000 si PORT no está definido.
